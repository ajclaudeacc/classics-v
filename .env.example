# Copy to .env.local for local development. Set the same values in Vercel.

# Supabase Transaction pooler connection string (port 6543). Keep it secret.
DATABASE_URL=

# Inquiry forms stay in preview mode (nothing saved) until this is "true".
# Only switch it on once Classics V has approved the site and will check the inquiries.
INQUIRY_FORM_LIVE=false

# Shows the "design preview" notice and keeps the site out of search engines.
# Set to "false" only when this becomes the official website.
NEXT_PUBLIC_PREVIEW_MODE=true
